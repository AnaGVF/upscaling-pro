PORT=4000

# These local paths are created by:
# npm run setup:tools
REAL_ESRGAN_BIN=tools\realesrgan-ncnn-vulkan\realesrgan-ncnn-vulkan.exe
REAL_ESRGAN_MODELS_DIR=tools\realesrgan-ncnn-vulkan\models
FFMPEG_BIN=tools\ffmpeg\bin\ffmpeg.exe
FFPROBE_BIN=tools\ffmpeg\bin\ffprobe.exe

REAL_ESRGAN_MODEL=realesrgan-x4plus
REAL_ESRGAN_SCALE=4

# Optional: force a specific GPU (0, 1, ...). Useful on laptops where the
# integrated GPU is picked instead of the dedicated one.
# REAL_ESRGAN_GPU_ID=1

# Natural detail blend. 0.20 is very subtle, 0.30 is the default natural look,
# 0.50 is sharper, and 1.00 is the full AI output.
AI_DETAIL_BLEND=0.30

MAX_UPLOAD_MB=1024
